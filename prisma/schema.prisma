// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── LocatieCheck ────────────────────────────────────────────────────────────

model LocatieCheck {
  id              String    @id @default(cuid())
  locatieNaam     String
  datum           DateTime
  afdeling        String
  doelgroep       String
  context         String    @default("") @db.Text
  conceptStatus   String    @default("concept") // "concept" | "definitief"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  observaties     Observatie[]
  themaScores     ThemaScore[]
  bomObservaties  BOMObservatie[]
  hospitalityItems HospitalityItem[]
}

// ─── Observatie ──────────────────────────────────────────────────────────────

model Observatie {
  id              String       @id @default(cuid())
  locatieCheckId  String
  locatieCheck    LocatieCheck @relation(fields: [locatieCheckId], references: [id], onDelete: Cascade)

  plaats          String       // huiskamer, gang, restaurant, tuin, etc.
  moment          String       // rondleiding, maaltijd, activiteit, overig
  bewijsType      String       // direct gezien, bewonersuiting, familie-uiting, teamuitleg
  tags            String       // JSON array: prikkel, bejegening, inrichting, maaltijd, ritueel, etc.
  inhoud          String       @db.Text // feitelijke observatie (1-3 zinnen)
  createdAt       DateTime     @default(now())
}

// ─── ThemaScore ──────────────────────────────────────────────────────────────

model ThemaScore {
  id                    String       @id @default(cuid())
  locatieCheckId        String
  locatieCheck          LocatieCheck @relation(fields: [locatieCheckId], references: [id], onDelete: Cascade)

  themaId               Int          // 1-10
  ingevoerdeScore       Float        @default(0)   // 1.0 - 10.0 in steps of 0.5 (0 = not filled)
  positiefBewijs        String       @default("") @db.Text // JSON array of strings
  negatiefBewijs        String       @default("") @db.Text // JSON array of strings
  positiefMetKanttekening String     @default("") @db.Text // JSON array of strings
  bewonersstem          String       @default("") @db.Text
  checkVraagAntwoorden  String       @default("") @db.Text // JSON: { vraagId: "Ja"|"Deels"|"Nee"|"Onbekend" }
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([locatieCheckId, themaId])
}

// ─── BOMObservatie ────────────────────────────────────────────────────────────

model BOMObservatie {
  id              String       @id @default(cuid())
  locatieCheckId  String
  locatieCheck    LocatieCheck @relation(fields: [locatieCheckId], references: [id], onDelete: Cascade)

  sectie          String       // eerste_indruk | bewoner_huiskamer | werkleefprocessen | bejegening | onbegrepen_gedrag
  antwoorden      String       @default("") @db.Text // JSON: { vraagId: string }
  prikkelDuiding  String       @default("") @db.Text // JSON: { type: gunstig|ongunstig, toelichting: string }
  gekoppeldeThemas String      @default("") @db.Text // JSON array of themaIds (e.g. [6,10,2])

  participerend   Boolean      @default(false)
  watDeedObserveerder String   @default("") @db.Text
  effectOpBewoners   String   @default("") @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([locatieCheckId, sectie])
}

// ─── HospitalityItem ─────────────────────────────────────────────────────────

model HospitalityItem {
  id              String       @id @default(cuid())
  locatieCheckId  String
  locatieCheck    LocatieCheck @relation(fields: [locatieCheckId], references: [id], onDelete: Cascade)

  categorie       String       // eerste_indruk | representativiteit | contactstijl | eten_drinken | tafeletiquette
  antwoorden      String       @default("") @db.Text // JSON: { itemId: boolean | null }
  notities        String       @default("") @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([locatieCheckId, categorie])
}

// ─── Bron ────────────────────────────────────────────────────────────────────

model Bron {
  id        String   @id @default(cuid())
  label     String   @unique // "IJKKADER v5" | "BOM Deel 3" | "Hospitality 01-2024"
  titel     String
  versie    String
  datum     String
  locatie   String   @default("") // URL or path to internal document
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
